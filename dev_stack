admin_main() {
  require_cmd python3
  if [[ ! -f "$ADMIN_AUTH_PATH" ]]; then
    echo "Missing admin authentication helper: $ADMIN_AUTH_PATH" >&2
    exit 1
  fi
  case "${1:-}" in
    status)
      [[ $# -eq 1 ]] || { admin_usage; exit 1; }
      exec python3 "$ADMIN_AUTH_PATH" status --state-file "$ADMIN_STATE_FILE"
      ;;
    password)
      if [[ "${2:-}" != "reset" || $# -ne 2 ]]; then
        admin_usage
        exit 1
      fi
      exec python3 "$ADMIN_AUTH_PATH" reset --state-file "$ADMIN_STATE_FILE"
      ;;
    help|-h|--help|"")
      admin_usage
      ;;
    *)
      echo "Unknown admin command: $1" >&2
      admin_usage
      exit 1
      ;;
  esac
}

credentials_main() {
  local command="${1:-}"
  local service=""
  local instance_name=""
  local json_mode="false"
  local credential_state_file=""
  local credential_instance=""
  local username_json="null"
  local password=""

  if [[ "$command" != "show" ]]; then
    credentials_usage
    exit 1
  fi
  shift
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --service)
        [[ $# -ge 2 ]] || { echo "--service requires a value" >&2; exit 1; }
        service="$2"
        shift 2
        ;;
      --instance-name)
        [[ $# -ge 2 ]] || { echo "--instance-name requires a value" >&2; exit 1; }
        instance_name="$(normalize_instance_name "$2")"
        shift 2
        ;;
      --json)
        json_mode="true"
        shift
        ;;
      -h|--help|help)
        credentials_usage
        exit 0
        ;;
      *)
        echo "Unknown credentials option: $1" >&2
        credentials_usage
        exit 1
        ;;
    esac
  done
  if [[ "$json_mode" != "true" ]]; then
    echo "Credential output requires --json." >&2
    exit 1
  fi
  case "$service" in
    code-server|filebrowser|porterminal|go2rtc)
      require_service_enabled "$service"
      ;;
    *)
      echo "Unsupported credential service: ${service:-<missing>}" >&2
      exit 1
      ;;
  esac

  case "$service" in
    code-server)
      [[ -n "$instance_name" ]] || { echo "code-server credentials require --instance-name" >&2; exit 1; }
      credential_state_file="${STATE_ROOT}/state-code-server.json"
      credential_instance="$instance_name"
      ;;
    filebrowser)
      [[ -z "$instance_name" ]] || { echo "filebrowser does not accept --instance-name" >&2; exit 1; }
      credential_state_file="${STATE_ROOT}/state-filebrowser.json"
      credential_instance="$FILEBROWSER_INSTANCE_NAME"
      username_json='"admin"'
      ;;
    porterminal)
      [[ -z "$instance_name" ]] || { echo "porterminal does not accept --instance-name" >&2; exit 1; }
      credential_state_file="${STATE_ROOT}/state-porterminal.json"
      credential_instance="$PORTERMINAL_INSTANCE_NAME"
      ;;
    go2rtc)
      [[ -z "$instance_name" ]] || { echo "go2rtc does not accept --instance-name" >&2; exit 1; }
      credential_state_file="${STATE_ROOT}/state-go2rtc.json"
      credential_instance="$GO2RTC_INSTANCE_NAME"
      username_json='"admin"'
      ;;
  esac

  if [[ ! -f "$credential_state_file" ]]; then
    echo "Credential state is unavailable for $service." >&2
    exit 3
  fi
  if [[ "$service" == "filebrowser" || "$service" == "porterminal" || "$service" == "go2rtc" ]]; then
    password="$(jq -r --arg name "$credential_instance" \
      --arg service "$service" \
      '.credentials[$service].password // .instances[$name].password // empty' \
      "$credential_state_file")"
  else
    password="$(jq -r --arg name "$credential_instance" '.instances[$name].password // empty' "$credential_state_file")"
  fi
  if [[ -z "$password" ]]; then
    echo "No recoverable credential is stored for ${service}${instance_name:+/$instance_name}." >&2
    exit 3
  fi

  jq -n \
    --arg service "$service" \
    --arg instance "$instance_name" \
    --arg password "$password" \
    --argjson username "$username_json" \
    '{service: $service, instance: (if $instance == "" then null else $instance end), username: $username, password: $password}'
}

run_all_status() {
  local service
  for service in code-server filebrowser porterminal go2rtc www; do
    if service_is_enabled "$service"; then
      echo "--${service}:"
      "$0" "$service" status || true
      echo "--"
    fi
  done
}

run_json_status() {
  require_cmd python3
  if [[ ! -f "$STATUS_SNAPSHOT_PATH" ]]; then
    echo "Missing status snapshot implementation: $STATUS_SNAPSHOT_PATH" >&2
    exit 1
  fi
  export DEV_STACK_STATE_ROOT="$STATE_ROOT"
  if [[ -n "$SETTINGS_FILE" ]]; then
    export DEV_STACK_SETTINGS_FILE="$SETTINGS_FILE"
  fi
  exec python3 "$STATUS_SNAPSHOT_PATH"
}

run_all_clean() {
  local service
  for service in code-server filebrowser porterminal go2rtc www; do
    if service_is_enabled "$service"; then
      echo "--${service}:"
      "$0" "$service" clean || true
      echo "--"
    fi
  done
}

main() {
  setup_colors
  load_settings

  if [[ $# -lt 1 ]]; then
    usage
    exit 1
  fi

  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    status)
      if [[ $# -eq 2 && "$2" == "--json" ]]; then
        run_json_status
      fi
      if [[ $# -ne 1 ]]; then
        echo "Usage: ${SCRIPT_NAME} status [--json]" >&2
        exit 1
      fi
      run_all_status
      exit 0
      ;;
    clean)
      run_all_clean
      exit 0
      ;;
    help)
      shift
      dispatch_service_help "$@"
      ;;
    credentials)
      shift
      credentials_main "$@"
      exit 0
      ;;
    admin)
      shift
      admin_main "$@"
      exit 0
      ;;
  esac

  SERVICE="$1"
  shift
  case "$SERVICE" in
    code-server|filebrowser|porterminal|go2rtc|www)
      require_service_enabled "$SERVICE"
      ;;
  esac

  case "$SERVICE" in
    code-server)
      STATE_DIR="$STATE_ROOT"
      STATE_FILE="${STATE_DIR}/state-code-server.json"
      code_server_main "$@"
      ;;
    filebrowser)
      STATE_DIR="$STATE_ROOT"
      STATE_FILE="${STATE_DIR}/state-filebrowser.json"
      filebrowser_main "$@"
      ;;
    porterminal)
      STATE_DIR="$STATE_ROOT"
      STATE_FILE="${STATE_DIR}/state-porterminal.json"
      porterminal_main "$@"
      ;;
    go2rtc)
      STATE_DIR="$STATE_ROOT"
      STATE_FILE="${STATE_DIR}/state-go2rtc.json"
      go2rtc_main "$@"
      ;;
    www)
      STATE_DIR="$STATE_ROOT"
      STATE_FILE="${STATE_DIR}/state-www.json"
      www_main "$@"
      ;;
    *)
      echo "Unknown service: $SERVICE" >&2
      echo "Supported services: code-server, filebrowser, porterminal, go2rtc, www" >&2
      usage
      exit 1
      ;;
  esac
}

main "$@"
