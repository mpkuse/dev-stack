setup_colors() {
  if [[ -t 1 ]] && [[ "${NO_COLOR:-}" == "" ]]; then
    C_RESET=$'\033[0m'
    C_BOLD=$'\033[1m'
    C_DIM=$'\033[2m'
    C_RED=$'\033[31m'
    C_GREEN=$'\033[32m'
    C_YELLOW=$'\033[33m'
    C_BLUE=$'\033[34m'
    C_CYAN=$'\033[36m'
  else
    C_RESET=""
    C_BOLD=""
    C_DIM=""
    C_RED=""
    C_GREEN=""
    C_YELLOW=""
    C_BLUE=""
    C_CYAN=""
  fi
}

status_color() {
  case "$1" in
    running) printf '%s' "$C_GREEN" ;;
    stopped|not_found) printf '%s' "$C_DIM" ;;
    drifted|unknown) printf '%s' "$C_YELLOW" ;;
    *) printf '%s' "$C_BLUE" ;;
  esac
}

status_dot() {
  local color
  color="$(status_color "$1")"
  printf '%s●%s' "$color" "$C_RESET"
}

format_yes_no() {
  if [[ "$1" == "yes" || "$1" == "true" ]]; then
    printf '%son%s' "$C_GREEN" "$C_RESET"
  else
    printf '%soff%s' "$C_DIM" "$C_RESET"
  fi
}

format_started_at() {
  local iso="$1"
  if [[ -z "$iso" ]]; then
    return
  fi
  date -d "$iso" "+%d-%m-%y %H:%M:%S %Z" 2>/dev/null
}

