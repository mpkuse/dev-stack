#!/usr/bin/env bash
set -euo pipefail

# dev_stack
#
# Manage local developer-stack services. Each service has its own subcommand surface.
#
# Usage:
#   dev_stack <service> <command> [options]
#   dev_stack status
#   dev_stack admin password reset
#   dev_stack credentials show --service <service> [--instance-name <name>] --json
#   dev_stack clean
#
# Supported services:
#   code-server   Manage the system-installed code-server and its Tailscale exposure.
#   filebrowser   Manage a single File Browser instance and its Tailscale exposure.
#   porterminal   Manage a single Porterminal instance and its Tailscale exposure.
#   go2rtc        Manage the local go2rtc Docker Compose deployment.
#   www           Serve the dev_stack status and limited-operations dashboard locally and over Tailscale.
#
# Run `dev_stack <service> help` for service-specific commands and options.
# Run `dev_stack status` to show every supported service status.
# Run `dev_stack clean` to clean stopped state for every supported service.

# code-server service
#
# Manage the system-installed code-server and its Tailscale exposure for named instances.
# This service is tested with code-server 4.115.0.
#
# Usage:
#   dev_stack code-server <start|stop|status|restart|clean> [options]
#   dev_stack code-server profile <save|list|start|delete> [profile-name] [--json]
#
# Options:
#   --instance-name <name>    Optional for start; auto-generates a friendly random name if omitted. Required for stop/restart.
#   --workspace-dir <path>    Workspace directory to open in code-server. Defaults to current working directory for start.
#   --port <port>             Bind port. Reuses state if omitted, otherwise auto-allocates.
#   --bind-host <host>        Bind host. Default: 127.0.0.1
#   --tailscale-no-serve      Skip Tailscale Serve for this instance.
#   --password-no-save        Don't persist the generated password in state (start only).
#   --help                    Show this help.
#
# State:
#   An initialized installation stores state in <prefix>/.dev-stack/state.
#   The state file stores known instances and last resolved runtime details.
#
# Tailscale model:
#   This service only manages routes under /code-server-manager/<instance-name>.
#   It refuses to touch routes outside that namespace.
#
# Development notes:
#   - Precedence is CLI > state > built-in defaults.
#   - `status` without --instance-name shows all managed instances.
#   - `status --instance-name <name>` reconciles one recorded instance.
#   - `stop` and `restart` require --instance-name.
#   - Ports are stable once assigned in state unless explicitly overridden.
#   - `clean` removes stopped instances from the state registry.
#   - Saved profiles contain only an instance name and absolute workspace path.
#   - `clean` never removes saved profiles.
#   - Tailscale route ownership is scoped to /code-server-manager/* only.

