  INSTALL_PREFIX="$(cd -- "${SCRIPT_DIR}/../.." && pwd -P)"
  DEFAULT_DEV_STACK_HOME="${INSTALL_PREFIX}/.dev-stack"
fi
if [[ -n "${DEV_STACK_HOME:-}" ]]; then
  DEV_STACK_HOME="$(mkdir -p -- "$DEV_STACK_HOME" && cd -- "$DEV_STACK_HOME" && pwd -P)"
elif [[ -n "$DEFAULT_DEV_STACK_HOME" && -d "$DEFAULT_DEV_STACK_HOME" ]]; then
  DEV_STACK_HOME="$DEFAULT_DEV_STACK_HOME"
else
  DEV_STACK_HOME=""
fi
if [[ -n "$DEV_STACK_HOME" ]]; then
